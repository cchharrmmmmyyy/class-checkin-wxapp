<!--components/teacher-tabbar/teacher-tabbar.wxml-->
<view class="tabbar">
  <view class="tabbar-item {{active === 0 ? 'active' : ''}}" bindtap="onSwitchTab" data-index="0" data-url="/pages/teacher/teacher">
    <text class="tabbar-icon">🏠</text>
    <text class="tabbar-text">首页</text>
  </view>
  <view class="tabbar-item {{active === 1 ? 'active' : ''}}" bindtap="onSwitchTab" data-index="1" data-url="/pages/teacher/leave-approval">
    <text class="tabbar-icon">📋</text>
    <text class="tabbar-text">请假审批</text>
  </view>
  <view class="tabbar-item {{active === 2 ? 'active' : ''}}" bindtap="onSwitchTab" data-index="2" data-url="/pages/teacher/monitor-manage">
    <text class="tabbar-icon">👥</text>
    <text class="tabbar-text">班委管理</text>
  </view>
</view>
