<view class="container">
  <view class="header">
    <view class="logo">班级考勤</view>
    <view class="subtitle">欢迎回来，请登录您的账号</view>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">学号/工号</text>
      <input class="input" type="text" placeholder="请输入账号" maxlength="12" bindinput="onUserIdInput" value="{{user_id}}" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" maxlength="20" bindinput="onPasswordInput" value="{{password}}" />
    </view>

    <button class="login-btn" bindtap="onLogin">登录</button>
  </view>

  <view class="footer">
    <text class="copyright">还没有账号？请联系管理员开通</text>
  </view>
</view>