/* pages/login/login.wxss */

.login-content {
  width: 100%;
  max-width: 640rpx;
  animation: fadeIn 0.6s ease-out;
}

.modern-card {
  background: #E8E8E8 !important;
}

.input-field {
  background: #FFFFFF !important;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.logo-section {
  text-align: left;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
}

.w-full {
  width: 100%;
}

.btn-text {
  font-size: 32rpx;
}

.btn-arrow {
  display: flex;
  align-items: center;
}

.footer-links {
  margin-top: 64rpx;
}
