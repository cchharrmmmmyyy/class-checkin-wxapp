.container {
  min-height: 100vh;
  background-color: var(--bg-color);
}

.profile-header {
  background-color: #fff;
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: var(--bg-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 32rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.menu-list {
  background-color: #fff;
  padding-bottom: 120rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.password-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 48rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  text-align: center;
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.modal-input {
  height: 88rpx;
  background-color: var(--bg-color);
  border-radius: var(--border-radius);
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--border-radius);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background-color: var(--bg-color);
  color: var(--text-color);
}

.modal-btn.confirm {
  background-color: var(--primary-color);
  color: #fff;
}