<!--pages/teacher/leave-approval.wxml-->
<view class="page-wrapper">
  <navbar title="请假审批" />
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title">请假审批</view>
    <view class="header-subtitle">待处理申请</view>
  </view>

  <!-- 班级选择卡片 -->
  <view class="modern-card mb-32 flex-between align-center" bindtap="onShowClassPicker">
    <view class="flex align-center">
      <text class="font-bold font-28">{{selectedClass || '请选择班级'}}</text>
    </view>
    <text class="nav-icon-text">▼</text>
  </view>

  <!-- 请假列表 -->
  <view class="leave-list">
    <view wx:if="{{isLoading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{leaveApplications.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无待处理申请</text>
    </view>

    <view wx:else>
      <view class="leave-card" wx:for="{{leaveApplications}}" wx:key="id">
        <view class="leave-header">
          <view class="student-info">
            <text class="student-name">{{item.username}}</text>
            <text class="student-id">{{item.user_id}}</text>
          </view>
        </view>
        
        <view class="leave-dates">
          <view class="date-item">
            <text class="date-label">开始日期</text>
            <text class="date-value">{{item.leave_start_date}}</text>
          </view>
          <text class="date-separator">→</text>
          <view class="date-item">
            <text class="date-label">结束日期</text>
            <text class="date-value">{{item.leave_end_date}}</text>
          </view>
        </view>

        <view class="leave-actions">
          <button class="reject-btn" data-leave-id="{{item.id}}" bindtap="onRejectLeave">
            <text>拒绝</text>
          </button>
          <button class="approve-btn" data-leave-id="{{item.id}}" bindtap="onApproveLeave">
            <text>同意</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 班级选择器弹窗 -->
  <view class="class-picker-mask" wx:if="{{showClassPicker}}" bindtap="onHideClassPicker">
    <view class="class-picker-content" catchtap="">
      <view class="picker-header mb-32 flex-between align-center">
        <text class="font-bold font-32">选择班级</text>
        <view class="picker-close" bindtap="onHideClassPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-body">
        <view class="class-item py-24 flex-between align-center" wx:for="{{classList}}" wx:key="*this" 
              data-class="{{item}}" bindtap="onSelectClass">
          <text class="font-bold {{selectedClass === item ? 'text-primary' : ''}}">{{item}}</text>
          <text wx:if="{{selectedClass === item}}" class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航栏组件 -->
  <teacher-tabbar active="1" />
</view>
