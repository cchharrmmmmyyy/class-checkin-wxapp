<view class="container">
  <view class="header">
    <view class="class-name">{{className}}</view>
    <picker mode="date" value="{{currentDate}}" bindchange="onDateChange">
      <view class="date-picker">
        <text class="date-label">日期：</text>
        <text class="date-value">{{currentDate}}</text>
      </view>
    </picker>
  </view>

  <view class="summary-strip">
    <view class="summary-item">
      <text class="summary-value">{{summary.present || 0}}</text>
      <text class="summary-label">已打卡</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.absent || 0}}</text>
      <text class="summary-label">未打卡</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.leave || 0}}</text>
      <text class="summary-label">请假</text>
    </view>
  </view>

  <view class="filter-bar">
    <picker mode="selector" range="{{statusOptions}}" bindchange="onFilterChange">
      <view class="filter-value">
        筛选：{{filterStatus}}
      </view>
    </picker>
  </view>

  <view class="student-list">
    <view class="student-card" wx:for="{{filteredStudents}}" wx:key="user_id">
      <view class="student-info">
        <text class="student-name">{{item.username}}</text>
        <text class="student-id">{{item.user_id}}</text>
      </view>
      <view class="status-tag status-{{item.status}}">
        <text wx:if="{{item.status === 'present'}}">{{item.punch_time}}</text>
        <text wx:elif="{{item.status === 'leave'}}">请假</text>
        <text wx:else>缺勤</text>
      </view>
    </view>

    <view class="no-data" wx:if="{{filteredStudents.length === 0}}">
      <text>暂无学生数据</text>
    </view>
  </view>

  <custom-tabbar current="0" role="teacher" />
</view>