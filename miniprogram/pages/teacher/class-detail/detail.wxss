.container {
  min-height: 100vh;
  background-color: var(--bg-color);
}

.header {
  background-color: #fff;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.class-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.date-value {
  font-size: 26rpx;
  color: var(--primary-color);
}

.summary-strip {
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.summary-item {
  text-align: center;
}

.summary-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.summary-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.filter-bar {
  background-color: #fff;
  padding: 16rpx 32rpx;
  margin-bottom: 24rpx;
}

.filter-value {
  font-size: 26rpx;
  color: var(--text-color);
}

.student-list {
  padding: 0 var(--padding-base);
}

.student-card {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.student-info {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.student-id {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.status-tag {
  padding: 8rpx 24rpx;
  border-radius: 4rpx;
  font-size: 26rpx;
}

.status-tag.status-punched {
  background-color: rgba(7, 193, 96, 0.1);
  color: var(--primary-color);
}

.status-tag.status-absent {
  background-color: rgba(238, 10, 36, 0.1);
  color: var(--danger-color);
}

.status-tag.status-leave {
  background-color: rgba(255, 151, 106, 0.1);
  color: var(--warning-color);
}

.no-data {
  text-align: center;
  padding: 100rpx;
  color: var(--text-secondary);
}