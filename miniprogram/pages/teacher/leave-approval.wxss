/* pages/teacher/leave-approval.wxss */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 请假列表 */
.leave-list {
  margin-top: 16rpx;
}

.loading-state,
.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.leave-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-light);
}

.leave-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.student-info {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 4rpx;
}

.student-id {
  font-size: 24rpx;
  color: var(--text-light);
}

.leave-dates {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.date-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.date-separator {
  font-size: 32rpx;
  color: var(--text-light);
  margin: 0 16rpx;
}

.leave-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.reject-btn,
.approve-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.reject-btn {
  background: #FFF1F0;
  color: var(--error-color);
}

.approve-btn {
  background: var(--primary-color);
  color: #FFFFFF;
}

.reject-btn:active,
.approve-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 班级选择器弹窗 */
.class-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.class-picker-content {
  width: 80%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: var(--shadow-heavy);
  animation: scaleUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleUp {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.picker-close {
  width: 64rpx;
  height: 64rpx;
  background: var(--input-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color);
}

.class-item {
  border-bottom: 1rpx solid #F0F0F0;
  padding: 24rpx 0;
}

.class-item:last-child {
  border-bottom: none;
}

.check-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.text-primary {
  color: var(--primary-color);
}

.py-24 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
