/* pages/teacher/monitor-manage.wxss */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

/* 班委列表 */
.monitor-section {
  margin-bottom: 48rpx;
}

.monitor-card-wrapper {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-light);
}

.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.monitor-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.monitor-item:last-child {
  border-bottom: none;
}

.monitor-info {
  display: flex;
  flex-direction: column;
}

.monitor-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 4rpx;
}

.monitor-id {
  font-size: 24rpx;
  color: var(--text-light);
}

.remove-btn {
  padding: 16rpx 28rpx;
  background: #FFF1F0;
  color: var(--error-color);
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.remove-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}

/* 任命班委 */
.appoint-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.appoint-form {
  display: flex;
  gap: 16rpx;
}

.appoint-input {
  flex: 1;
  height: 88rpx;
  background: #F8F9FA;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-color);
}

.appoint-btn {
  width: 160rpx;
  height: 88rpx;
  background: var(--primary-color);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.appoint-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 班级选择器弹窗 */
.class-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.class-picker-content {
  width: 80%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: var(--shadow-heavy);
  animation: scaleUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleUp {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.picker-close {
  width: 64rpx;
  height: 64rpx;
  background: var(--input-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color);
}

.class-item {
  border-bottom: 1rpx solid #F0F0F0;
  padding: 24rpx 0;
}

.class-item:last-child {
  border-bottom: none;
}

.check-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.text-primary {
  color: var(--primary-color);
}

.py-24 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
