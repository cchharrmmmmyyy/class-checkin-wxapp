/* pages/teacher/teacher.wxss */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.user-header {
  padding-top: 24rpx;
}

.text-error {
  color: var(--error-color);
}

.mr-16 {
  margin-right: 16rpx;
}

.py-24 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

/* 班级选择器弹窗 */
.class-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.class-picker-content {
  width: 80%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: var(--shadow-heavy);
  animation: scaleUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scaleUp {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.picker-close {
  width: 64rpx;
  height: 64rpx;
  background: var(--input-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-color);
}

.class-item {
  border-bottom: 1rpx solid #F0F0F0;
  padding: 24rpx 0;
}

.class-item:last-child {
  border-bottom: none;
}

.check-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.text-primary {
  color: var(--primary-color);
}
