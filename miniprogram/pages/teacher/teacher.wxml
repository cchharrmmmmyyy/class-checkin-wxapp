<!--pages/teacher/teacher.wxml-->
<view class="page-wrapper">
  <navbar title="校园打卡" />
  <!-- 用户信息头部 -->
  <view class="user-header mb-48">
    <view>
      <view class="section-title mb-8" style="margin-bottom: 8rpx;">教师管理</view>
      <view class="text-secondary font-28">欢迎您，{{userInfo.username}}</view>
    </view>
  </view>

  <view class="page-content">
    <!-- 班级选择卡片 -->
    <view class="modern-card mb-32 flex-between align-center" bindtap="onShowClassPicker">
      <view class="flex align-center">
        <text class="font-bold font-28">{{selectedClass || '请选择班级'}}</text>
      </view>
      <text class="nav-icon-text">▼</text>
    </view>

    <!-- 班级打卡率 -->
    <view class="modern-card mb-32">
      <view class="card-title mb-32">打卡概况</view>
      <view class="flex-center flex-column mb-32">
        <view class="font-64 font-black text-primary">{{punchRate}}%</view>
        <text class="text-light font-24">今日打卡率</text>
      </view>
      
      <view class="records-list">
        <view class="record-item flex-between align-center py-24" style="border-top: 1rpx solid var(--card-border);" wx:for="{{classRecords}}" wx:key="user_id">
          <view class="flex align-center">
            <view class="flex-column">
              <text class="font-bold font-28">{{item.username}}</text>
              <text class="text-light font-24">{{item.user_id}}</text>
            </view>
          </view>
          <view class="flex align-center">
            <view class="status-tag mr-16 {{item.role === 'monitor' ? 'normal' : ''}}" style="margin-right: 16rpx;">{{item.role === 'monitor' ? '班委' : '学生'}}</view>
            <text class="font-26 {{item.punched ? 'text-primary' : 'text-error'}} font-bold">{{item.punchTime || '未打卡'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航栏组件 -->
  <teacher-tabbar active="0" />

  <!-- 班级选择器弹窗 -->
  <view class="class-picker-mask" wx:if="{{showClassPicker}}" bindtap="onHideClassPicker">
    <view class="class-picker-content" catchtap="">
      <view class="picker-header mb-32 flex-between align-center">
        <text class="font-bold font-32">选择班级</text>
        <view class="picker-close" bindtap="onHideClassPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-body">
        <view class="class-item py-24 flex-between align-center" wx:for="{{classList}}" wx:key="*this" 
              data-class="{{item}}" bindtap="onSelectClass">
          <text class="font-bold {{selectedClass === item ? 'text-primary' : ''}}">{{item}}</text>
          <text wx:if="{{selectedClass === item}}" class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>
