<!--pages/teacher/monitor-manage.wxml-->
<view class="page-wrapper">
  <navbar title="班委管理" />
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title">班委管理</view>
    <view class="header-subtitle">任命和移除班委</view>
  </view>

  <!-- 班级选择卡片 -->
  <view class="modern-card mb-32 flex-between align-center" bindtap="onShowClassPicker">
    <view class="flex align-center">
      <text class="font-bold font-28">{{selectedClass || '请选择班级'}}</text>
    </view>
    <text class="nav-icon-text">▼</text>
  </view>

  <!-- 任命班委 -->
  <view class="appoint-section mb-32">
    <view class="section-title">任命班委</view>
    <view class="appoint-form">
      <input 
        class="appoint-input" 
        placeholder="请输入学号" 
        value="{{studentId}}" 
        bindinput="onStudentIdInput" 
      />
      <button class="appoint-btn" bindtap="onAppointMonitor">
        <text>任命</text>
      </button>
    </view>
  </view>

  <!-- 当前班委列表 -->
  <view class="monitor-section">
    <view class="section-title">当前班委</view>
    
    <view class="monitor-card-wrapper">
      <view wx:if="{{currentMonitors.length === 0}}" class="empty-state">
        <text class="empty-icon">👤</text>
        <text class="empty-text">暂无班委</text>
      </view>

      <view wx:else class="monitor-list">
        <view class="monitor-item" wx:for="{{currentMonitors}}" wx:key="user_id">
          <view class="monitor-info">
            <text class="monitor-name">{{item.username}}</text>
            <text class="monitor-id">{{item.user_id}}</text>
          </view>
          <button class="remove-btn" data-student-id="{{item.user_id}}" bindtap="onRemoveMonitor">
            <text>移除</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 班级选择器弹窗 -->
  <view class="class-picker-mask" wx:if="{{showClassPicker}}" bindtap="onHideClassPicker">
    <view class="class-picker-content" catchtap="">
      <view class="picker-header mb-32 flex-between align-center">
        <text class="font-bold font-32">选择班级</text>
        <view class="picker-close" bindtap="onHideClassPicker">
          <text>✕</text>
        </view>
      </view>
      <view class="picker-body">
        <view class="class-item py-24 flex-between align-center" wx:for="{{classList}}" wx:key="*this" 
              data-class="{{item}}" bindtap="onSelectClass">
          <text class="font-bold {{selectedClass === item ? 'text-primary' : ''}}">{{item}}</text>
          <text wx:if="{{selectedClass === item}}" class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航栏组件 -->
  <teacher-tabbar active="2" />
</view>
