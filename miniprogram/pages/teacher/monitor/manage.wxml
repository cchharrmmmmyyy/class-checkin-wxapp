<view class="container">
  <view class="class-selector">
    <picker mode="selector" range="{{classes}}" range-key="class_name" bindchange="onClassChange">
      <view class="selector-value">
        班级：{{selectedClass}}
      </view>
    </picker>
  </view>

  <view class="student-list">
    <view class="student-card" wx:for="{{students}}" wx:key="user_id">
      <view class="student-info">
        <text class="student-name">{{item.username}}</text>
        <text class="student-id">{{item.user_id}}</text>
      </view>
      <view class="monitor-tag" wx:if="{{item.is_monitor}}">
        <text>班委</text>
      </view>
      <button class="action-btn {{item.is_monitor ? 'remove' : 'appoint'}}" bindtap="{{item.is_monitor ? 'onRemove' : 'onAppoint'}}" data-student="{{item}}">
        {{item.is_monitor ? '撤销班委' : '任命为班委'}}
      </button>
    </view>

    <view class="no-data" wx:if="{{students.length === 0}}">
      <text>暂无学生数据</text>
    </view>
  </view>
</view>