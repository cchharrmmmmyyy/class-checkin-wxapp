<!--pages/student/class-records.wxml-->
<view class="page-wrapper">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title">班级打卡记录</view>
    <view class="header-date">{{todayDate}}</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-cards">
    <view class="stat-card">
      <text class="stat-number">{{totalCount}}</text>
      <text class="stat-label">总人数</text>
    </view>
    <view class="stat-card">
      <text class="stat-number punched">{{punchedCount}}</text>
      <text class="stat-label">已打卡</text>
    </view>
    <view class="stat-card">
      <text class="stat-number leave">{{leaveCount}}</text>
      <text class="stat-label">请假</text>
    </view>
    <view class="stat-card">
      <text class="stat-number unpunched">{{unpunchedCount}}</text>
      <text class="stat-label">未打卡</text>
    </view>
  </view>

  <!-- 学生列表 -->
  <view class="student-list">
    <view class="list-header">
      <text class="list-title">学生列表</text>
    </view>
    
    <view wx:if="{{classRecords.length === 0}}" class="empty-state">
      <text class="empty-text">暂无数据</text>
    </view>

    <view wx:for="{{classRecords}}" wx:key="user_id" class="student-item">
      <view class="student-info">
        <text class="student-name">{{item.username}}</text>
        <text class="student-id">{{item.user_id}}</text>
      </view>
      <view class="student-status {{item.punched ? 'punched' : (item.on_leave ? 'leave' : 'unpunched')}}">
        <text>{{item.punchTime}}</text>
      </view>
    </view>
  </view>

  <!-- 底部导航栏组件 -->
  <student-tabbar active="3" isMonitor="{{true}}" />
</view>
