/* pages/student/student-detail.wxss */

.user-header {
  padding-top: 24rpx;
}

.w-full {
  width: 100%;
}

.record-item, .class-record-item {
  padding: 32rpx;
}

.icon-circle {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.py-48 {
  padding-top: 48rpx;
  padding-bottom: 48rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  opacity: 0.7;
}
