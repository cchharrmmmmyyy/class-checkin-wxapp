/* pages/student/leave-apply.wxss */

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  opacity: 0.7;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
}

.input-field {
  margin-bottom: 0;
}

.day-count {
  display: flex;
  justify-content: flex-end;
}

.w-full {
  width: 100%;
}

/* 选择器弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.picker-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  padding: 48rpx;
  z-index: 1001;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  animation: slideUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-display {
  padding: 40rpx 0;
  text-align: center;
  border-top: 1rpx solid var(--card-border);
  border-bottom: 1rpx solid var(--card-border);
}
