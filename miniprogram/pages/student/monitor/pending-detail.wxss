.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.info-tip {
  background-color: #e6f7ff;
  border: 1px solid #91d5ff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #1890ff;
}

.list-section {
  margin-bottom: 20rpx;
}

.list-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.student-id {
  font-size: 24rpx;
  color: #999;
}

.item-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  font-size: 28rpx;
  line-height: 1.5;
}

.info-row .label {
  color: #666;
  min-width: 140rpx;
}

.info-row .value {
  color: #333;
  flex: 1;
}

.status {
  font-weight: 500;
}

.status.pending {
  color: #faad14;
}

.status.approved {
  color: #52c41a;
}

.status.rejected {
  color: #f5222d;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
