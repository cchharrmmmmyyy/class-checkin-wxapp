/* pages/student/leave-records.wxss */

.back-btn, .icon-btn {
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active, .icon-btn:active {
  opacity: 0.7;
}

.record-item {
  padding: 32rpx;
}

.icon-circle {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.py-48 {
  padding-top: 48rpx;
  padding-bottom: 48rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
}

.ml-8 {
  margin-left: 8rpx;
}
