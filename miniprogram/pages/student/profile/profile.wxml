<view class="container">
  <view class="profile-header">
    <view class="avatar">头像</view>
    <view class="user-info">
      <text class="username">{{userInfo.username}}</text>
      <text class="user-id">学号：{{userInfo.user_id}}</text>
      <text class="class-name">班级：{{userInfo.class_name}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" wx:if="{{userInfo.role === 'monitor'}}" bindtap="goToMonitorDashboard">
      <text class="menu-icon">📊</text>
      <text class="menu-text">班委工作台</text>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="onChangePassword">
      <text class="menu-icon">🔐</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="onLogout">
      <text class="menu-icon">🚪</text>
      <text class="menu-text">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <modal class="password-modal" hidden="{{!showPasswordModal}}" bindcancel="onCancelPassword">
    <view class="modal-content">
      <view class="modal-title">修改密码</view>

      <view class="input-group">
        <input class="modal-input" type="password" placeholder="请输入旧密码" bindinput="onOldPasswordInput" value="{{oldPassword}}" />
        <input class="modal-input" type="password" placeholder="请输入新密码（6-20位）" bindinput="onNewPasswordInput" value="{{newPassword}}" />
      </view>

      <view class="modal-buttons">
        <button class="modal-btn cancel" bindtap="onCancelPassword">取消</button>
        <button class="modal-btn confirm" bindtap="onSubmitPassword">确定</button>
      </view>
    </view>
  </modal>

  <custom-tabbar current="2" />
</view>