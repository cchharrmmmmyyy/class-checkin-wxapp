.container {
  min-height: 100vh;
  background-color: var(--bg-color);
}

.header-bar {
  padding: var(--padding-base);
  display: flex;
  justify-content: flex-end;
}

.mark-all-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  background: none;
  padding: 8rpx 16rpx;
}

.mark-all-btn::after {
  border: none;
}

.notification-list {
  padding: 0 var(--padding-base);
}

.notification-item {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.notification-item.unread {
  background-color: rgba(7, 193, 96, 0.05);
}

.notification-content {
  flex: 1;
}

.notification-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.notification-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.notification-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: var(--danger-color);
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.no-data {
  text-align: center;
  padding: 100rpx;
  color: var(--text-secondary);
}