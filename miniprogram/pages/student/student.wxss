/* pages/student/student.wxss */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.user-header {
  padding-top: 24rpx;
}

/* 打卡圆形区域 */
.punch-section {
  padding: 40rpx 0;
}

.punch-circle-container {
  width: 320rpx;
  height: 320rpx;
  position: relative;
}

.punch-circle-outer {
  width: 100%;
  height: 100%;
  background: rgba(29, 112, 245, 0.1);
  border-radius: 50%;
  padding: 24rpx;
  box-sizing: border-box;
}

.punch-circle-inner {
  width: 100%;
  height: 100%;
  background: var(--primary-color);
  border-radius: 50%;
  box-shadow: var(--shadow-heavy);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.punch-icon {
  font-size: 80rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.punch-circle-container:active .punch-circle-inner {
  transform: scale(0.92);
  background: var(--primary-dark);
}

.w-full {
  width: 100%;
}
