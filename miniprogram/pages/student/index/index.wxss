.container {
  padding: var(--padding-base);
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 120rpx;
}

.header-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 0;
}

.notification-icon {
  position: relative;
  padding: 16rpx;
}

.bell {
  font-size: 48rpx;
}

.badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: var(--danger-color);
  border-radius: 50%;
}

.status-card {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 32rpx;
}

.status-content {
  text-align: center;
  padding: 32rpx 0;
}

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.status-text.success {
  color: var(--primary-color);
}

.status-text.warning {
  color: var(--warning-color);
}

.punch-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.punch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 32rpx;
  border-radius: var(--border-radius);
  margin-top: 32rpx;
}

.punch-btn.disabled {
  background-color: var(--text-secondary);
}

.btn-icon {
  margin-right: 12rpx;
}

.quick-actions {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.action-list {
  display: flex;
  gap: 32rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background-color: var(--bg-color);
  border-radius: var(--border-radius);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.action-text {
  font-size: 28rpx;
  color: var(--text-color);
}