<view class="container">
  <view class="header-bar">
    <view class="notification-icon" bindtap="goToNotifications">
      <text class="bell">🔔</text>
      <view class="badge" wx:if="{{unreadCount > 0}}"></view>
    </view>
  </view>

  <view class="status-card">
    <view class="card-title">📍 当前打卡状态</view>

    <view class="status-content" wx:if="{{hasPunched}}">
      <view class="status-text success">今日已打卡</view>
      <view class="punch-info">
        <text class="info-item">打卡时间：{{punchTime}}</text>
        <text class="info-item">打卡地点：{{punchLocation}}</text>
      </view>
    </view>

    <view class="status-content" wx:else>
      <view class="status-text warning">未打卡</view>
      <view class="punch-info">
        <text class="info-item">请在规定时间内完成打卡</text>
      </view>
    </view>

    <button class="punch-btn {{hasPunched ? 'disabled' : ''}}" bindtap="onPunch" disabled="{{hasPunched}}">
      <text class="btn-icon">📷</text>
      <text class="btn-text">{{hasPunched ? '已打卡' : '立即打卡'}}</text>
    </button>
  </view>

  <view class="quick-actions">
    <view class="section-title">快捷操作</view>
    <view class="action-list">
      <view class="action-item" bindtap="goToLeaveApply">
        <text class="action-icon">📝</text>
        <text class="action-text">请假</text>
      </view>
      <view class="action-item" bindtap="goToMakeupApply">
        <text class="action-icon">🔄</text>
        <text class="action-text">补卡</text>
      </view>
    </view>
  </view>

  <custom-tabbar current="0" />
</view>