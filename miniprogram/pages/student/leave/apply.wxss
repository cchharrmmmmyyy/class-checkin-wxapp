.container {
  padding: var(--padding-base);
  min-height: 100vh;
  background-color: var(--bg-color);
}

.form {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker-value {
  height: 88rpx;
  background-color: var(--bg-color);
  border-radius: var(--border-radius);
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.picker-value.placeholder {
  color: var(--text-secondary);
}

.textarea {
  width: 100%;
  height: 200rpx;
  background-color: var(--bg-color);
  border-radius: var(--border-radius);
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  height: 88rpx;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 32rpx;
  border-radius: var(--border-radius);
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  opacity: 0.8;
}