/**app.wxss**/
@import "styles/theme.wxss";
@import "styles/base.wxss";

/* 全局基础设置 */
page {
  font-family: 'HarmonyOS Sans SC', 'MiSans', 'PingFang SC', -apple-system, 
    BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, 
    Roboto, 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  background-color: var(--background-color);
  color: var(--text-color);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 统一滚动条隐藏 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
