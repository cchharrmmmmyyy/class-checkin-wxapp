/* 全局主题配置 - 换肤只需修改此处 */
/* 主题变量定义 - 采用参考图片的现代简约风格 */
page {
  /* 主色调 - 活力蓝 */
  --primary-color: #1D70F5;
  --primary-light: #E8F1FF;
  --primary-dark: #0052D9;
  
  /* 辅助色 */
  --secondary-color: #000000; /* 黑色用于强调 */
  --accent-green: #2ECC71;    /* 绿色用于成功/正常状态 */
  
  /* 背景色 */
  --background-color: #FFFFFF;
  --page-bg: #FFFFFF;
  
  /* 文字颜色 */
  --text-color: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --text-white: #FFFFFF;
  
  /* 组件颜色 */
  --card-bg: #F4F5F7;
  --card-border: transparent;
  --input-bg: #FFFFFF;
  --input-border: #E8E8E8;
  
  /* 状态颜色 */
  --success-color: #2ECC71;
  --warning-color: #F39C12;
  --error-color: #E74C3C;
  --info-color: #1D70F5;
  
  /* 阴影 - 更加细腻现代 */
  --shadow-light: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  --shadow-medium: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  --shadow-heavy: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  
  /* 动画时长 */
  --transition-fast: 0.2s;
  --transition-normal: 0.3s;
  --transition-slow: 0.4s;
  
  /* 圆角 - 采用大圆角风格 */
  --radius-small: 12rpx;
  --radius-medium: 24rpx;
  --radius-large: 40rpx;
  --radius-full: 100rpx;
}

/* 兼容原有页面的主题切换类，但统一风格为现代简约 */
.theme-blue, .theme-purple, .theme-red, .theme-dark {
  /* 强制覆盖为统一的现代风格，仅保留主色差异 */
}

.theme-blue {
  --primary-color: #1D70F5;
  --primary-light: #E8F1FF;
}

.theme-purple {
  --primary-color: #722ed1;
  --primary-light: #f9f0ff;
}

.theme-red {
  --primary-color: #f5222d;
  --primary-light: #fff1f0;
}

.theme-dark {
  --background-color: #121212;
  --page-bg: #1E1E1E;
  --text-color: #E0E0E0;
  --text-secondary: #AAAAAA;
  --card-bg: #2C2C2C;
  --card-border: #333333;
  --input-bg: #333333;
  --input-border: #444444;
}
