/* 全局基础样式 - 包含通用工具类 - 现代简约风格 */

/* 全局页面容器 */
.global-container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 32rpx;
  box-sizing: border-box;
}

/* 现代卡片效果 */
.modern-card {
  background: var(--card-bg);
  border-radius: var(--radius-medium);
  padding: 40rpx;
  margin-bottom: 32rpx;
  transition: all var(--transition-normal) ease;
}

.modern-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

/* 黑色按钮样式 - 参考图片中的风格 */
.dark-btn {
  background: #000000 !important;
  color: #FFFFFF !important;
  border-radius: var(--radius-full) !important;
  padding: 24rpx 48rpx !important;
  font-weight: 600 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: 1.5 !important;
}

/* 主按钮样式 - 现代简约 */
.primary-btn {
  background: var(--primary-color) !important;
  color: var(--text-white) !important;
  border: none !important;
  border-radius: var(--radius-full) !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  padding: 24rpx 48rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all var(--transition-normal) ease;
  line-height: 1.5 !important;
}

/* 次要按钮样式 */
.secondary-btn {
  background: var(--primary-light);
  color: var(--primary-color);
  border: none;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 40rpx;
}

/* 统一输入框样式 */
.input-field {
  width: 100%;
  height: 96rpx;
  background: var(--input-bg);
  border: 1rpx solid var(--input-border);
  border-radius: var(--radius-medium);
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.input-field:focus {
  border-color: var(--primary-color);
  background: #FFFFFF;
}

/* 统一大标题样式 */
.section-title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-color);
  line-height: 1.2;
  margin-bottom: 48rpx;
  letter-spacing: -1rpx;
}

.w-full {
  width: 100% !important;
}

/* 通用容器 */
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 页面内容容器 */
.page-content {
  width: 100%;
  margin: 0 auto;
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

/* 文本样式 */
.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--text-secondary); }
.text-light { color: var(--text-light); font-size: 24rpx; }
.text-black { color: #000000; }

/* 状态标签 */
.status-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
}

.status-tag.normal {
  background: #E8F9F0;
  color: var(--accent-green);
}

/* 间距工具类 */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }

.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mb-48 { margin-bottom: 48rpx; }

/* Flex 布局工具类 */
.flex { display: flex; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-end { display: flex; justify-content: flex-end; align-items: center; }
.align-center { align-items: center; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }

/* 文字对齐 */
.text-center { text-align: center; }

/* 字体大小 */
.font-24 { font-size: 24rpx; }
.font-28 { font-size: 28rpx; }
.font-32 { font-size: 32rpx; }
.font-40 { font-size: 40rpx; }
.font-64 { font-size: 64rpx; }

/* 字体粗细 */
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }
