.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mt-50 { margin-top: 50rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.mb-50 { margin-bottom: 50rpx; }

.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.ml-30 { margin-left: 30rpx; }

.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.mr-30 { margin-right: 30rpx; }

.pt-20 { padding-top: 20rpx; }
.pt-30 { padding-top: 30rpx; }
.pt-40 { padding-top: 40rpx; }

.pb-20 { padding-bottom: 20rpx; }
.pb-30 { padding-bottom: 30rpx; }
.pb-40 { padding-bottom: 40rpx; }

/* Flex 布局工具类 */
.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-center { justify-content: center; align-items: center; }
.flex-between { justify-content: space-between; }
.flex-around { justify-content: space-around; }
.flex-start { justify-content: flex-start; }
.flex-end { justify-content: flex-end; }
.align-center { align-items: center; }
.align-start { align-items: flex-start; }
.align-end { align-items: flex-end; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* 文字对齐 */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 字体大小 */
.font-24 { font-size: 24rpx; }
.font-26 { font-size: 26rpx; }
.font-28 { font-size: 28rpx; }
.font-30 { font-size: 30rpx; }
.font-32 { font-size: 32rpx; }
.font-36 { font-size: 36rpx; }
.font-40 { font-size: 40rpx; }
.font-44 { font-size: 44rpx; }

/* 字体粗细 */
.font-bold { font-weight: bold; }
.font-normal { font-weight: normal; }
.font-light { font-weight: 300; }

/* 圆角 */
.radius-small { border-radius: var(--radius-small); }
.radius-medium { border-radius: var(--radius-medium); }
.radius-large { border-radius: var(--radius-large); }
.radius-full { border-radius: var(--radius-full); }

/* 浮动动画 */
@keyframes vibrantFloat {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.05);
  }
}

/* 脉冲动画 */
@keyframes vibrantPulse {
  0% {
    transform: scale(1);
    opacity: 0.7;
    box-shadow: 0 0 30rpx rgba(255, 255, 255, 0.3);
  }
  100% {
    transform: scale(1.3);
    opacity: 0.9;
    box-shadow: 0 0 50rpx rgba(255, 255, 255, 0.5);
  }
}

.animate-float {
  animation: vibrantFloat 3s ease-in-out infinite;
}

.animate-pulse {
  animation: vibrantPulse 2s ease-in-out infinite;
}
