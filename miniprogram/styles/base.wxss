/* 全局基础样式 - 包含通用工具类 */

/* 全局页面容器 */
.global-container {
  min-height: 100vh;
  background: linear-gradient(45deg, var(--background-gradient-start), var(--background-gradient-end), var(--background-gradient-mid1), var(--background-gradient-mid2));
  background-size: 600% 600%;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
  animation: vibrantBackground 8s ease-in-out infinite;
}

/* 活力背景动画 */
@keyframes vibrantBackground {
  0% {
    background-position: 0% 50%;
  }
  25% {
    background-position: 100% 50%;
  }
  50% {
    background-position: 100% 100%;
  }
  75% {
    background-position: 0% 100%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* 磨砂玻璃卡片效果 */
.glass-card {
  background: var(--card-bg);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-large);
  padding: 60rpx 50rpx;
  box-shadow: 0 20rpx 60rpx var(--shadow-light);
  position: relative;
  z-index: 2;
  transition: all var(--transition-slow) cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card:hover {
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 30rpx 80rpx var(--shadow-medium);
  transform: translateY(-10rpx);
}

/* 主按钮样式 */
.primary-btn {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: var(--text-white);
  border: none;
  border-radius: var(--radius-full);
  font-size: 34rpx;
  font-weight: bold;
  padding: 25rpx 60rpx;
  box-shadow: 0 10rpx 30rpx var(--shadow-heavy);
  transition: all var(--transition-slow) cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
  pointer-events: none;
}

.primary-btn:active::after {
  width: 300rpx;
  height: 300rpx;
}

.primary-btn:active {
  transform: scale(0.95) translateY(2rpx);
  box-shadow: 0 5rpx 20rpx var(--shadow-medium);
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
}

.primary-btn:hover {
  box-shadow: 0 15rpx 40rpx var(--shadow-heavy);
  transform: translateY(-3rpx);
}

/* 次要按钮样式 */
.secondary-btn {
  background: var(--input-bg);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 50rpx;
  box-shadow: 0 5rpx 20rpx var(--shadow-light);
  transition: all var(--transition-normal) ease;
}

.secondary-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx var(--shadow-medium);
}

.secondary-btn:hover {
  background: var(--primary-color);
  color: var(--text-white);
  box-shadow: 0 8rpx 25rpx var(--shadow-medium);
}

/* 统一输入框样式 */
.input-field {
  width: 100%;
  height: 80rpx;
  background: var(--input-bg);
  border: none;
  border-bottom: 2rpx solid var(--input-border);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
  transition: all var(--transition-normal) ease;
  outline: none;
  border-radius: var(--radius-small);
  box-shadow: 0 2rpx 10rpx var(--shadow-light);
  margin-bottom: 40rpx;
}

.input-field:focus {
  border-bottom-color: var(--primary-color);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 20rpx var(--shadow-light);
  transform: translateY(-2rpx);
}

.input-field::placeholder {
  color: var(--light-green);
  font-size: 28rpx;
  font-weight: 400;
}

/* 统一标题样式 */
.section-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-align: center;
  margin-bottom: 50rpx;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 2rpx 10rpx var(--shadow-light);
}

/* 通用容器 */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 页面内容容器 */
.page-content {
  flex: 1;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 卡片标题 */
.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 30rpx;
  letter-spacing: 2rpx;
}

/* 文本样式 */
.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--secondary-color);
}

.text-light {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.text-white {
  color: var(--text-white);
}

