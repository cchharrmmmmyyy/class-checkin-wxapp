# JWT 密钥（生产环境必须设置，使用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=your-strong-random-secret-key-here

# Token 过期时间（小时）
TOKEN_EXPIRE_HOURS=24

# 数据库文件路径
DATABASE_FILE=user.db

# 是否插入测试数据（True/False）
INSERT_TEST_DATA=True

# Flask 服务器主机地址
FLASK_HOST=0.0.0.0

# Flask 服务器端口
FLASK_PORT=5000

# Flask 调试模式（开发环境设为 True，生产环境必须设为 False）
FLASK_DEBUG=True

# 重置密码时的随机密码长度
RANDOM_PASSWORD_LENGTH=8

# 打卡记录查询限制条数
PUNCH_RECORDS_LIMIT=30
